# ==========================================
# HICE Server Configuration
# ==========================================
APP_NAME=HICE-Security-Platform
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# ==========================================
# Database Configuration (MySQL)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hice_db

# ==========================================
# Security & JWT Tokens
# ==========================================
# Generate a strong 256-bit key via: openssl rand -hex 32
JWT_SECRET_KEY=hice_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Storage Vault Paths
# ==========================================
VAULT_STORAGE_PATH=./app/storage/vault
SAMPLES_STORAGE_PATH=./app/storage/samples
MAX_UPLOAD_SIZE_MB=50

# ==========================================
# AI Monitoring Settings
# ==========================================
ANOMALY_CONTAMINATION=0.05
MAX_FAILED_LOGINS_THRESHOLD=5
MAX_DECRYPTION_FAILS_THRESHOLD=3
